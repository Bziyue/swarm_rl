  <snippet name="tilt_des">
   <global></global>
   <function>w = value
x = v1
y = v2
z = v3

dcm22 = 1 - 2 * (x * x + y * y)

dcm22 = math.max(-1.0, math.min(1.0, dcm22))

tilt = math.acos(dcm22)

return tilt * 180 / math.pi</function>
